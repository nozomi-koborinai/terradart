/// Synth entry point: `terradart synth` and `dart run bin/infra.dart` write
/// every Stack's `main.tf.json` under `tf-out/`, mirroring the
/// migrated module tree.
///
/// `terradart plan --env <name>` and
/// `dart run bin/infra.dart --env <name>` write that environment.
/// Without `--env`, every environment is written.
library;

import 'package:config_tree/cloud_run_stack.dart';
import 'package:config_tree/cloud_sql_stack.dart';
import 'package:config_tree/config_tree_stack.dart';
import 'package:config_tree/env.dart';
import 'package:config_tree/pubsub_stack.dart';
import 'package:config_tree/secret_manager_stack.dart';
import 'package:config_tree/service_account_stack.dart';
import 'package:config_tree/workload_identity_stack.dart';
import 'package:terradart_core/terradart_core.dart';

Future<void> main(List<String> args) async {
  await CloudRunStack().writeTo('tf-out/modules/cloud_run');
  await CloudSqlStack().writeTo('tf-out/modules/cloud_sql');
  await PubsubStack().writeTo('tf-out/modules/pubsub');
  await SecretManagerStack().writeTo('tf-out/modules/secret_manager');
  await ServiceAccountStack().writeTo('tf-out/modules/service_account');
  await WorkloadIdentityStack().writeTo('tf-out/modules/workload_identity');
  await runEnvironments(
    args,
    Env.values,
    (env) => ConfigTreeStack(env: env),
    dir: (env) => 'tf-out/${env.path}',
  );
}
