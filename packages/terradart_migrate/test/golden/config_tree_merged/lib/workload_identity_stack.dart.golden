/// WorkloadIdentityStack — migrated from `workload_identity` by terradart-migrate {{version}}.
///
/// One Stack per Terraform module directory. Resource addresses are
/// preserved, so `terraform plan` against the existing state reports
/// no changes once the sidecar is in place.
library;

import 'package:terradart_core/terradart_core.dart';
import 'package:terradart_google/iam.dart';
import 'package:terradart_google/provider.dart';

final class WorkloadIdentityStack extends Stack {
  WorkloadIdentityStack() : super(providers: [const GoogleProvider()]) {
    final github = add(
      GoogleIamWorkloadIdentityPool(
        localName: r'github',
        workloadIdentityPoolId: .literal(r'github-pool'),
      ),
    );
    add(
      GoogleIamWorkloadIdentityPoolProvider(
        localName: r'github',
        workloadIdentityPoolId: .ref(
          TfRef.attribute<String>(github, r'workload_identity_pool_id'),
        ),
        workloadIdentityPoolProviderId: .literal(r'github-provider'),
        trustSource: .oidc(
          issuerUri: .literal(r'https://token.actions.githubusercontent.com'),
        ),
      ),
    );
    add(
      GoogleServiceAccountIamMember(
        localName: r'github_actions',
        serviceAccountId: .literal(
          r'projects/example-project/serviceAccounts/gha-deploy@example-project.iam.gserviceaccount.com',
        ),
        role: .literal(r'roles/iam.workloadIdentityUser'),
        member: .literal(
          r'principalSet://iam.googleapis.com/example/attribute.repository/owner/repo',
        ),
      ),
    );
  }
}
