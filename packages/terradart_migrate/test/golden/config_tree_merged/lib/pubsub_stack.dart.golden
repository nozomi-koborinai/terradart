/// PubsubStack — migrated from `pubsub` by terradart-migrate {{version}}.
///
/// One Stack per Terraform module directory. Resource addresses are
/// preserved, so `terraform plan` against the existing state reports
/// no changes once the sidecar is in place.
library;

import 'package:terradart_core/terradart_core.dart';
import 'package:terradart_google/iam.dart';
import 'package:terradart_google/provider.dart';
import 'package:terradart_google/pubsub.dart';

final class PubsubStack extends Stack {
  PubsubStack() : super(providers: [const GoogleProvider()]) {
    addVariable(r'topic', const TfVariable(type: r'string'));
    final thisPubsubTopic = add(
      GooglePubsubTopic(localName: r'this', name: .variable(r'topic')),
    );
    add(
      GooglePubsubSubscription(
        localName: r'this',
        name: .expression(r'${var.topic}-sub'),
        topic: thisPubsubTopic.ref.pinned(r'name'),
      ),
    );
    add(
      GoogleServiceAccountIamMember(
        localName: r'publisher',
        serviceAccount: .literal(
          r'projects/example-project/serviceAccounts/publisher@example-project.iam.gserviceaccount.com',
        ),
        role: .literal(r'roles/iam.serviceAccountTokenCreator'),
        member: .literal(
          r'serviceAccount:service-pubsub@example-project.iam.gserviceaccount.com',
        ),
      ),
    );
  }
}
