/// CloudRunModule — the `cloud_run` module as a Dart value, generated by
/// terradart-migrate {{version}} from its `variable` and `output` blocks.
///
/// The module itself stays Terraform: `source` is the path to its directory,
/// relative to the directory the calling Stack synthesizes into.
library;

import 'package:terradart_core/terradart_core.dart';

final class CloudRunModule extends ModuleCall {
  CloudRunModule({
    required super.localName,
    required super.source,
    super.version,
    super.providers,
    super.dependsOn,
    required TfArg<String> name,
  }) : super(inputs: {'name': name});

  /// `${module.<name>.service_name}`
  TfRef<String> get serviceName =>
      TfRef.attribute<String>(this, 'service_name');
}
