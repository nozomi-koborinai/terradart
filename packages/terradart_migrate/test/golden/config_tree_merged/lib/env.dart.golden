/// The environments `ConfigTreeStack` synthesizes for — migrated by
/// terradart-migrate {{version}}.
///
/// One member per environment root, carrying every value the roots disagree
/// on. Add an environment by adding a member: the Stack is the same code.
library;

enum Env {
  /// `dev/`, synthesized into `tf-out/dev`.
  dev(
    path: 'dev',
    assetsName: 'app-dev-assets',
    uploadsName: 'app-dev-uploads',
    cloudSqlInstanceName: 'app-postgres-dev',
    projectIdDefault: 'example-project-dev',
    backendBucket: 'app-dev-tfstate',
    backendPrefix: 'infra/dev',
  ),

  /// `prod/`, synthesized into `tf-out/prod`.
  prod(
    path: 'prod',
    assetsName: 'app-prod-assets',
    uploadsName: 'app-prod-uploads',
    cloudSqlInstanceName: 'app-postgres-prod',
    projectIdDefault: 'example-project-prod',
    backendBucket: 'app-prod-tfstate',
    backendPrefix: 'infra/prod',
    isProd: true,
  );

  const Env({
    required this.path,
    required this.assetsName,
    required this.uploadsName,
    required this.cloudSqlInstanceName,
    required this.projectIdDefault,
    required this.backendBucket,
    required this.backendPrefix,
    this.isProd = false,
  });

  /// Where this environment synthesizes, relative to the package root.
  final String path;

  /// `google_storage_bucket.assets.name`.
  final String assetsName;

  /// `google_storage_bucket.uploads.name`.
  final String uploadsName;

  /// `module.cloud_sql.instance_name`.
  final String cloudSqlInstanceName;

  /// `variable.project_id.default`.
  final String projectIdDefault;

  /// `terraform.backend.bucket`.
  final String backendBucket;

  /// `terraform.backend.prefix`.
  final String backendPrefix;

  /// True in prod: blocks only that environment declares.
  final bool isProd;

  /// The environment called [name] (`dev`), or `null`.
  static Env? byName(String name) => values.asNameMap()[name];
}
