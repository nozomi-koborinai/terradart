/// ServiceAccountStack — migrated from `service_account` by terradart-migrate {{version}}.
///
/// One Stack per Terraform module directory. Resource addresses are
/// preserved, so `terraform plan` against the existing state reports
/// no changes once the sidecar is in place.
library;

import 'package:terradart_core/terradart_core.dart';
import 'package:terradart_google/iam.dart';
import 'package:terradart_google/provider.dart';

final class ServiceAccountStack extends Stack {
  ServiceAccountStack() : super(providers: [const GoogleProvider()]) {
    addVariable('account_id', const TfVariable(type: 'string'));
    final thisServiceAccount = add(
      GoogleServiceAccount(
        localName: 'this',
        accountId: .variable('account_id'),
      ),
    );
    add(
      GoogleProjectIamMember(
        localName: 'log_writer',
        project: .literal('example-project'),
        role: .literal('roles/logging.logWriter'),
        member: .arg(
          .expression(r'serviceAccount:${google_service_account.this.email}'),
        ),
      ),
    );
    addOutput('id', .ref(thisServiceAccount.id));
    addOutput(
      'member',
      .ref(TfRef.attribute<Object?>(thisServiceAccount, 'member')),
    );
  }
}
