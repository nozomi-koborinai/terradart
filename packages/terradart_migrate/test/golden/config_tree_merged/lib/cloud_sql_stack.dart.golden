/// CloudSqlStack — migrated from `cloud_sql` by terradart-migrate {{version}}.
///
/// One Stack per Terraform module directory. Resource addresses are
/// preserved, so `terraform plan` against the existing state reports
/// no changes once the sidecar is in place.
library;

import 'package:terradart_google/cloud_sql.dart';
import 'package:terradart_google/provider.dart';

final class CloudSqlStack extends Stack {
  CloudSqlStack() : super(providers: [const GoogleProvider()]) {
    final instanceName = variable<String>('instance_name');
    final thisSqlDatabaseInstance = add(
      GoogleSqlDatabaseInstance(
        'this',
        databaseVersion: .postgres15,
        name: instanceName,
        region: .literal('asia-northeast1'),
        settings: SqlDatabaseInstanceSettings(tier: .literal('db-f1-micro')),
      ),
    );
    add(
      GoogleSqlDatabase(
        'app',
        name: .literal('app'),
        instance: thisSqlDatabaseInstance.ref,
      ),
    );
    add(
      GoogleSqlUser(
        'app',
        name: .literal('app'),
        instance: thisSqlDatabaseInstance.ref,
      ),
    );
  }
}
