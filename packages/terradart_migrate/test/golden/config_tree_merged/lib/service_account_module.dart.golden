/// ServiceAccountModule — the `service_account` module as a Dart value, generated by
/// terradart-migrate {{version}} from its `variable` and `output` blocks.
///
/// The module itself stays Terraform: `source` is the path to its directory,
/// relative to the directory the calling Stack synthesizes into.
library;

import 'package:terradart_core/terradart_core.dart';

final class ServiceAccountModule extends ModuleCall {
  ServiceAccountModule({
    required String localName,
    required String source,
    String? version,
    Map<String, String> providers = const {},
    List<DependencyTarget>? dependsOn,
    required TfArg<String> accountId,
  }) : super(
         localName: localName,
         source: source,
         version: version,
         providers: providers,
         dependsOn: dependsOn,
         inputs: {r'account_id': accountId},
       );

  /// `${module.<name>.id}`
  TfRef<String> get id => TfRef.attribute<String>(this, r'id');

  /// `${module.<name>.member}`
  TfRef<String> get member => TfRef.attribute<String>(this, r'member');
}
