/// DevStack — migrated from `dev` by terradart-migrate {{version}}.
///
/// One Stack per Terraform module directory. Resource addresses are
/// preserved, so `terraform plan` against the existing state reports
/// no changes once the sidecar is in place.
library;

import 'package:terradart_core/terradart_core.dart';
import 'package:terradart_google/artifact_registry.dart';
import 'package:terradart_google/cloud_run.dart';
import 'package:terradart_google/data.dart';
import 'package:terradart_google/iam.dart';
import 'package:terradart_google/project.dart';
import 'package:terradart_google/provider.dart';
import 'package:terradart_google/storage.dart';
import 'cloud_run_module.dart';
import 'cloud_sql_module.dart';
import 'pubsub_module.dart';
import 'service_account_module.dart';

final class DevStack extends Stack {
  DevStack()
    : super(
        providers: [const GoogleProvider()],
        backend: const GcsBackend(
          bucket: 'app-dev-tfstate',
          prefix: 'infra/dev',
        ),
      ) {
    addVariable(
      'project_id',
      const TfVariable(type: 'string', defaultValue: 'example-project-dev'),
    );
    addVariable(
      'region',
      const TfVariable(type: 'string', defaultValue: 'asia-northeast1'),
    );
    // Environment root module. Resources declared directly here, plus calls into
    // the shared local modules under ../modules.
    addData(
      GoogleProject(localName: 'current', projectId: .variable('project_id')),
    );
    add(
      GoogleProjectService(
        localName: 'run',
        service: .literal('run.googleapis.com'),
      ),
    );
    add(
      GoogleArtifactRegistryRepository(
        localName: 'images',
        repositoryId: .literal('app-images'),
        format: .literal('DOCKER'),
        location: .variable('region'),
      ),
    );
    final assets = add(
      GoogleStorageBucket(
        localName: 'assets',
        name: .literal('app-dev-assets'),
        location: .variable('region'),
      ),
    );
    final uploads = add(
      GoogleStorageBucket(
        localName: 'uploads',
        name: .literal('app-dev-uploads'),
        location: .variable('region'),
      ),
    );
    add(
      GoogleStorageBucketIamMember(
        localName: 'assets_public',
        bucket: assets.ref,
        role: .literal('roles/storage.objectViewer'),
        member: .allUsers,
      ),
    );
    add(
      GoogleCloudRunV2Job(
        localName: 'db_migrate',
        name: .literal('app-db-migrate'),
        location: .variable('region'),
        template: CloudRunV2JobTemplate(
          template: .new(
            containers: [
              .new(image: .literal('gcr.io/example-project/db-migrate:latest')),
            ],
          ),
        ),
      ),
    );
    final saBff = addModule(
      ServiceAccountModule(
        localName: 'sa_bff',
        source: '../modules/service_account',
        accountId: .literal('app-bff-sa'),
      ),
    );
    final saWorker = addModule(
      ServiceAccountModule(
        localName: 'sa_worker',
        source: '../modules/service_account',
        accountId: .literal('app-worker-sa'),
      ),
    );
    final saAdkAgent = addModule(
      ServiceAccountModule(
        localName: 'sa_adk_agent',
        source: '../modules/service_account',
        accountId: .literal('app-agent-sa'),
      ),
    );
    addModule(
      ServiceAccountModule(
        localName: 'sa_github_actions',
        source: '../modules/service_account',
        accountId: .literal('app-gha-sa'),
      ),
    );
    addModule(
      ModuleCall(localName: 'app_secrets', source: '../modules/secret_manager'),
    );
    final cloudRunBff = addModule(
      CloudRunModule(
        localName: 'cloud_run_bff',
        source: '../modules/cloud_run',
        name: .literal('app-bff'),
      ),
    );
    addModule(
      CloudRunModule(
        localName: 'cloud_run_worker',
        source: '../modules/cloud_run',
        name: .literal('app-worker'),
      ),
    );
    addModule(
      CloudSqlModule(
        localName: 'cloud_sql',
        source: '../modules/cloud_sql',
        instanceName: .literal('app-postgres-dev'),
      ),
    );
    addModule(
      PubsubModule(
        localName: 'pubsub_webhook',
        source: '../modules/pubsub',
        topic: .literal('app-webhook-events'),
      ),
    );
    addModule(
      ModuleCall(
        localName: 'workload_identity',
        source: '../modules/workload_identity',
      ),
    );
    add(
      GoogleStorageBucketIamMember(
        localName: 'uploads_admin',
        bucket: uploads.ref,
        role: .literal('roles/storage.objectAdmin'),
        member: .arg(.ref(saWorker.member)),
      ),
    );
    add(
      GoogleStorageBucketIamMember(
        localName: 'uploads_reader',
        bucket: uploads.ref,
        role: .literal('roles/storage.objectViewer'),
        member: .arg(.ref(saBff.member)),
      ),
    );
    add(
      GoogleCloudRunV2ServiceIamMember(
        localName: 'bff_invoker',
        service: .arg(.ref(cloudRunBff.serviceName)),
        role: .literal('roles/run.invoker'),
        member: .allUsers,
      ),
    );
    add(
      GoogleProjectIamMember(
        localName: 'worker_token_creator',
        project: .variable('project_id'),
        role: .literal('roles/iam.serviceAccountTokenCreator'),
        member: .arg(.ref(saWorker.member)),
      ),
    );
    add(
      GoogleServiceAccountIamMember(
        localName: 'agent_user',
        serviceAccount: .arg(.ref(saAdkAgent.id)),
        role: .literal('roles/iam.serviceAccountUser'),
        member: .arg(.ref(saBff.member)),
      ),
    );
  }
}
