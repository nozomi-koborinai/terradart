/// ProdStack — migrated from `prod` by terradart-migrate {{version}}.
///
/// One Stack per Terraform module directory. Resource addresses are
/// preserved, so `terraform plan` against the existing state reports
/// no changes once the sidecar is in place.
library;

import 'package:terradart_core/terradart_core.dart';
import 'package:terradart_google/artifact_registry.dart';
import 'package:terradart_google/cloud_run.dart';
import 'package:terradart_google/data.dart';
import 'package:terradart_google/iam.dart';
import 'package:terradart_google/project.dart';
import 'package:terradart_google/provider.dart';
import 'package:terradart_google/storage.dart';
import 'cloud_run_module.dart';
import 'cloud_sql_module.dart';
import 'pubsub_module.dart';
import 'service_account_module.dart';

final class ProdStack extends Stack {
  ProdStack()
    : super(
        providers: [const GoogleProvider()],
        backend: const GcsBackend(
          bucket: r'app-prod-tfstate',
          prefix: r'infra/prod',
        ),
      ) {
    addVariable(
      r'project_id',
      const TfVariable(type: r'string', defaultValue: r'example-project-prod'),
    );
    addVariable(
      r'region',
      const TfVariable(type: r'string', defaultValue: r'asia-northeast1'),
    );
    addData(
      GoogleProject(
        localName: r'current',
        projectId: TfArg.variable(r'project_id'),
      ),
    );
    add(
      GoogleProjectService(
        localName: r'run',
        service: TfArg.literal(r'run.googleapis.com'),
      ),
    );
    add(
      GoogleArtifactRegistryRepository(
        localName: r'images',
        repositoryId: TfArg.literal(r'app-images'),
        format: TfArg.literal(r'DOCKER'),
        location: TfArg.variable(r'region'),
      ),
    );
    final assets = add(
      GoogleStorageBucket(
        localName: r'assets',
        name: TfArg.literal(r'app-prod-assets'),
        location: TfArg.variable(r'region'),
      ),
    );
    final uploads = add(
      GoogleStorageBucket(
        localName: r'uploads',
        name: TfArg.literal(r'app-prod-uploads'),
        location: TfArg.variable(r'region'),
      ),
    );
    final backups = add(
      GoogleStorageBucket(
        localName: r'backups',
        name: TfArg.literal(r'app-prod-backups'),
        location: TfArg.variable(r'region'),
      ),
    );
    add(
      GoogleStorageBucketIamMember(
        localName: r'assets_public',
        bucket: TfArg.ref(assets.nameRef),
        role: TfArg.literal(r'roles/storage.objectViewer'),
        member: TfArg.literal(r'allUsers'),
      ),
    );
    add(
      GoogleCloudRunV2Job(
        localName: r'db_migrate',
        name: TfArg.literal(r'app-db-migrate'),
        location: TfArg.variable(r'region'),
        template: CloudRunV2JobTemplate(
          template: CloudRunV2JobTaskTemplate(
            containers: [
              CloudRunV2JobContainer(
                image: TfArg.literal(
                  r'gcr.io/example-project/db-migrate:latest',
                ),
              ),
            ],
          ),
        ),
      ),
    );
    final saBff = addModule(
      ServiceAccountModule(
        localName: r'sa_bff',
        source: r'../modules/service_account',
        accountId: TfArg.literal(r'app-bff-sa'),
      ),
    );
    final saWorker = addModule(
      ServiceAccountModule(
        localName: r'sa_worker',
        source: r'../modules/service_account',
        accountId: TfArg.literal(r'app-worker-sa'),
      ),
    );
    final saAdkAgent = addModule(
      ServiceAccountModule(
        localName: r'sa_adk_agent',
        source: r'../modules/service_account',
        accountId: TfArg.literal(r'app-agent-sa'),
      ),
    );
    addModule(
      ServiceAccountModule(
        localName: r'sa_github_actions',
        source: r'../modules/service_account',
        accountId: TfArg.literal(r'app-gha-sa'),
      ),
    );
    addModule(
      ModuleCall(
        localName: r'app_secrets',
        source: r'../modules/secret_manager',
      ),
    );
    final cloudRunBff = addModule(
      CloudRunModule(
        localName: r'cloud_run_bff',
        source: r'../modules/cloud_run',
        name: TfArg.literal(r'app-bff'),
      ),
    );
    addModule(
      CloudRunModule(
        localName: r'cloud_run_worker',
        source: r'../modules/cloud_run',
        name: TfArg.literal(r'app-worker'),
      ),
    );
    addModule(
      CloudSqlModule(
        localName: r'cloud_sql',
        source: r'../modules/cloud_sql',
        instanceName: TfArg.literal(r'app-postgres-prod'),
      ),
    );
    addModule(
      PubsubModule(
        localName: r'pubsub_webhook',
        source: r'../modules/pubsub',
        topic: TfArg.literal(r'app-webhook-events'),
      ),
    );
    addModule(
      ModuleCall(
        localName: r'workload_identity',
        source: r'../modules/workload_identity',
      ),
    );
    add(
      GoogleStorageBucketIamBinding(
        localName: r'backups_admins',
        bucket: TfArg.ref(backups.nameRef),
        role: TfArg.literal(r'roles/storage.objectAdmin'),
        members: TfArg.literal([saWorker.member.interpolation]),
      ),
    );
    add(
      GoogleStorageBucketIamMember(
        localName: r'uploads_admin',
        bucket: TfArg.ref(uploads.nameRef),
        role: TfArg.literal(r'roles/storage.objectAdmin'),
        member: TfArg.ref(saWorker.member),
      ),
    );
    add(
      GoogleStorageBucketIamMember(
        localName: r'uploads_reader',
        bucket: TfArg.ref(uploads.nameRef),
        role: TfArg.literal(r'roles/storage.objectViewer'),
        member: TfArg.ref(saBff.member),
      ),
    );
    add(
      GoogleCloudRunV2ServiceIamMember(
        localName: r'bff_invoker',
        name: TfArg.ref(cloudRunBff.serviceName),
        role: TfArg.literal(r'roles/run.invoker'),
        member: TfArg.literal(r'allUsers'),
      ),
    );
    add(
      GoogleProjectIamMember(
        localName: r'worker_token_creator',
        project: TfArg.variable(r'project_id'),
        role: TfArg.literal(r'roles/iam.serviceAccountTokenCreator'),
        member: TfArg.ref(saWorker.member),
      ),
    );
    add(
      GoogleServiceAccountIamMember(
        localName: r'agent_user',
        serviceAccountId: TfArg.ref(saAdkAgent.id),
        role: TfArg.literal(r'roles/iam.serviceAccountUser'),
        member: TfArg.ref(saBff.member),
      ),
    );
  }
}
