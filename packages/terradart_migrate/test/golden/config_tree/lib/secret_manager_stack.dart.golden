/// SecretManagerStack — migrated from `secret_manager` by terradart-migrate {{version}}.
///
/// One Stack per Terraform module directory. Resource addresses are
/// preserved, so `terraform plan` against the existing state reports
/// no changes once the sidecar is in place.
library;

import 'package:terradart_core/terradart_core.dart';
import 'package:terradart_google/provider.dart';
import 'package:terradart_google/secret_manager.dart';

final class SecretManagerStack extends Stack {
  SecretManagerStack() : super(providers: [const GoogleProvider()]) {
    add(
      GoogleSecretManagerSecret(
        localName: r'db_password',
        secretId: TfArg.literal(r'db-password'),
        replication: SecretManagerSecretAutoReplication(),
      ),
    );
    add(
      GoogleSecretManagerSecret(
        localName: r'api_key',
        secretId: TfArg.literal(r'api-key'),
        replication: SecretManagerSecretAutoReplication(),
      ),
    );
  }
}
