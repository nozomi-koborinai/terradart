name: real_plan_src
description: Migrated from `real_plan_src` by terradart-migrate {{version}}.
publish_to: none

environment:
  sdk: ^3.10.0

dependencies:
  terradart_core: ^{{version}}
  terradart_google: ^{{version}}

dev_dependencies:
  lints: ^6.0.0

# The migrated tree's state was written by Terraform, so `terradart plan`
# and `apply` keep running Terraform on it. Set `engine: tofu` to move the
# state to OpenTofu at the next apply.
terradart:
  engine: terraform
