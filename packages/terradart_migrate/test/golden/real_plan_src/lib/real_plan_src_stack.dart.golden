/// RealPlanSrcStack — migrated from `real_plan_src` by terradart-migrate {{version}}.
///
/// One Stack per Terraform module directory. Resource addresses are
/// preserved, so `terraform plan` against the existing state reports
/// no changes once the sidecar is in place.
library;

import 'package:terradart_core/terradart_core.dart';
import 'package:terradart_google/compute.dart';
import 'package:terradart_google/iam.dart';
import 'package:terradart_google/identity.dart';
import 'package:terradart_google/provider.dart';
import 'package:terradart_google/pubsub.dart';
import 'package:terradart_google/storage.dart';

final class RealPlanSrcStack extends Stack {
  RealPlanSrcStack()
    : super(
        providers: [
          const GoogleProvider(
            project: 'example-dogfood-project',
            region: 'us-central1',
          ),
        ],
      ) {
    // --- Curated by terradart_google (expected: supported) ---
    add(
      GoogleStorageBucket(
        'assets',
        name: .literal('example-dogfood-assets'),
        location: .literal('US'),
        forceDestroy: .literal(true),
      ),
    );
    add(GooglePubsubTopic('events', name: .literal('events')));
    add(
      GoogleServiceAccount(
        'ci',
        accountId: .literal('ci-runner'),
        displayName: .literal('CI Runner'),
      ),
    );
    final router = add(
      GoogleComputeRouter(
        'router',
        name: .literal('example-router'),
        network: .network(.literal('default')),
        region: .literal('us-central1'),
      ),
    );
    add(
      GoogleComputeRouterNat(
        'nat',
        name: .literal('example-nat'),
        router: router.ref,
        region: .literal('us-central1'),
        sourceSubnetworkIpRangesToNat: .allSubnetworksAllIpRanges,
        natIpAllocateOption: .autoOnly,
      ),
    );
    // --- Still uncurated in terradart_google (not a required sentinel) ---
    add(
      GoogleIdentityPlatformOauthIdpConfig(
        'hello',
        name: .literal('oidc.hello'),
        issuer: .literal('https://accounts.example.com'),
        clientId: .literal('dummy'),
      ),
    );
    addModule(ModuleCall('network', source: './modules/network'));
  }
}
