/// NetworkStack — migrated from `network` by terradart-migrate {{version}}.
///
/// One Stack per Terraform module directory. Resource addresses are
/// preserved, so `terraform plan` against the existing state reports
/// no changes once the sidecar is in place.
library;

import 'package:terradart_core/terradart_core.dart';
import 'package:terradart_google/compute.dart';
import 'package:terradart_google/provider.dart';

final class NetworkStack extends Stack {
  NetworkStack() : super(providers: [const GoogleProvider()]) {
    // All curated by terradart_google (expected: supported). Lives in a child module
    // so the fixture exercises per-module breakdown and child_modules recursion.
    final vpc = add(
      GoogleComputeNetwork(
        localName: r'vpc',
        name: .literal(r'example-vpc'),
        autoCreateSubnetworks: .literal(false),
      ),
    );
    add(
      GoogleComputeSubnetwork(
        localName: r'subnet',
        name: .literal(r'example-subnet'),
        region: .literal(r'us-central1'),
        network: .ref(vpc.id),
        ipCidrRange: .literal(r'10.0.0.0/24'),
      ),
    );
    add(
      GoogleComputeRoute(
        localName: r'egress',
        name: .literal(r'example-egress'),
        network: .ref(vpc.nameRef),
        destRange: .literal(r'0.0.0.0/0'),
        nextHop: .gateway(
          nextHopGateway: .literal(r'default-internet-gateway'),
        ),
      ),
    );
  }
}
