{
  "terraform": {
    "required_version": ">= 1.11.0",
    "required_providers": {
      "appwrite": {
        "source": "appwrite/appwrite",
        "version": "2.7.0"
      }
    }
  },
  "variable": {
    "compression": {
      "type": "string"
    },
    "backup_access_key": {
      "type": "string",
      "sensitive": true
    },
    "backup_secret_key": {
      "type": "string",
      "sensitive": true
    }
  },
  "resource": {
    "appwrite_function": {
      "fn": {
        "name": "shapes",
        "runtime": "dart-3.5",
        "schedule": "0 * * * *"
      }
    },
    "appwrite_function_variable": {
      "mode": {
        "function_id": "${appwrite_function.fn.id}",
        "key": "FUNCTION_NAME",
        "value": "${appwrite_function.fn.name}"
      }
    },
    "appwrite_storage_bucket": {
      "literal": {
        "name": "literal",
        "compression": "gzip",
        "permissions": [
          "read(\"any\")",
          "write(\"users\")"
        ]
      },
      "variable": {
        "name": "variable",
        "compression": "${var.compression}"
      },
      "expression": {
        "name": "expression",
        "compression": "${lower(var.compression)}"
      },
      "unlisted": {
        "name": "unlisted",
        "compression": "unlisted",
        "permissions": [
          "read(\"any\")",
          "write(\"users\")"
        ]
      }
    },
    "appwrite_mongo_database": {
      "mongo": {
        "name": "shapes"
      }
    },
    "appwrite_mongo_backup_storage": {
      "backups": {
        "database_id": "${appwrite_mongo_database.mongo.id}",
        "storage_provider": "s3",
        "bucket": "shapes-backups",
        "access_key": "${var.backup_access_key}",
        "secret_key": "${var.backup_secret_key}"
      }
    }
  }
}
