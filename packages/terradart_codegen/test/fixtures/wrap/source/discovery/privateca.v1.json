{
  "name": "privateca",
  "version": "v1",
  "revision": "20261021",
  "sourceUrl": "https://privateca.googleapis.com/$discovery/rest?version=v1",
  "schemas": {
    "AllowedKeyType": {
      "properties": {
        "ellipticCurve": {
          "$ref": "EcKeyType"
        }
      }
    },
    "AttributeTypeAndValue": {
      "properties": {
        "type": {
          "enum": [
            "ATTRIBUTE_TYPE_UNSPECIFIED",
            "COMMON_NAME",
            "COUNTRY_CODE",
            "ORGANIZATION",
            "ORGANIZATIONAL_UNIT",
            "LOCALITY",
            "PROVINCE",
            "STREET_ADDRESS",
            "POSTAL_CODE"
          ]
        }
      }
    },
    "CaPool": {
      "properties": {
        "tier": {
          "enum": [
            "TIER_UNSPECIFIED",
            "ENTERPRISE",
            "DEVOPS"
          ]
        },
        "issuancePolicy": {
          "$ref": "IssuancePolicy"
        },
        "publishingOptions": {
          "$ref": "PublishingOptions"
        }
      }
    },
    "Certificate": {
      "properties": {
        "revocationDetails": {
          "$ref": "RevocationDetails"
        },
        "config": {
          "$ref": "CertificateConfig"
        },
        "subjectMode": {
          "enum": [
            "SUBJECT_REQUEST_MODE_UNSPECIFIED",
            "DEFAULT",
            "RDN_SEQUENCE",
            "REFLECTED_SPIFFE"
          ]
        },
        "certificateDescription": {
          "$ref": "CertificateDescription"
        }
      }
    },
    "CertificateAuthority": {
      "properties": {
        "config": {
          "$ref": "CertificateConfig"
        },
        "state": {
          "enum": [
            "STATE_UNSPECIFIED",
            "ENABLED",
            "DISABLED",
            "STAGED",
            "AWAITING_USER_ACTIVATION",
            "DELETED"
          ]
        },
        "tier": {
          "enum": [
            "TIER_UNSPECIFIED",
            "ENTERPRISE",
            "DEVOPS"
          ]
        },
        "type": {
          "enum": [
            "TYPE_UNSPECIFIED",
            "SELF_SIGNED",
            "SUBORDINATE"
          ]
        },
        "keySpec": {
          "$ref": "KeyVersionSpec"
        },
        "caCertificateDescriptions": {
          "items": {
            "$ref": "CertificateDescription"
          }
        }
      }
    },
    "CertificateConfig": {
      "properties": {
        "subjectConfig": {
          "$ref": "SubjectConfig"
        },
        "publicKey": {
          "$ref": "PublicKey"
        }
      }
    },
    "CertificateDescription": {
      "properties": {
        "subjectDescription": {
          "$ref": "SubjectDescription"
        },
        "publicKey": {
          "$ref": "PublicKey"
        }
      }
    },
    "CertificateExtensionConstraints": {
      "properties": {
        "knownExtensions": {
          "items": {
            "enum": [
              "KNOWN_CERTIFICATE_EXTENSION_UNSPECIFIED",
              "BASE_KEY_USAGE",
              "EXTENDED_KEY_USAGE",
              "CA_OPTIONS",
              "POLICY_IDS",
              "AIA_OCSP_SERVERS",
              "NAME_CONSTRAINTS"
            ]
          }
        }
      }
    },
    "CertificateTemplate": {
      "properties": {
        "passthroughExtensions": {
          "$ref": "CertificateExtensionConstraints"
        }
      }
    },
    "EcKeyType": {
      "properties": {
        "signatureAlgorithm": {
          "enum": [
            "EC_SIGNATURE_ALGORITHM_UNSPECIFIED",
            "ECDSA_P256",
            "ECDSA_P384",
            "EDDSA_25519"
          ]
        }
      }
    },
    "IssuancePolicy": {
      "properties": {
        "passthroughExtensions": {
          "$ref": "CertificateExtensionConstraints"
        },
        "allowedKeyTypes": {
          "items": {
            "$ref": "AllowedKeyType"
          }
        }
      }
    },
    "KeyVersionSpec": {
      "properties": {
        "algorithm": {
          "enum": [
            "SIGN_HASH_ALGORITHM_UNSPECIFIED",
            "RSA_PSS_2048_SHA256",
            "RSA_PSS_3072_SHA256",
            "RSA_PSS_4096_SHA256",
            "RSA_PKCS1_2048_SHA256",
            "RSA_PKCS1_3072_SHA256",
            "RSA_PKCS1_4096_SHA256",
            "EC_P256_SHA256",
            "EC_P384_SHA384"
          ]
        }
      }
    },
    "PublicKey": {
      "properties": {
        "format": {
          "enum": [
            "KEY_FORMAT_UNSPECIFIED",
            "PEM"
          ]
        }
      }
    },
    "PublishingOptions": {
      "properties": {
        "encodingFormat": {
          "enum": [
            "ENCODING_FORMAT_UNSPECIFIED",
            "PEM",
            "DER"
          ]
        }
      }
    },
    "RelativeDistinguishedName": {
      "properties": {
        "attributes": {
          "items": {
            "$ref": "AttributeTypeAndValue"
          }
        }
      }
    },
    "RevocationDetails": {
      "properties": {
        "revocationState": {
          "enum": [
            "REVOCATION_REASON_UNSPECIFIED",
            "KEY_COMPROMISE",
            "CERTIFICATE_AUTHORITY_COMPROMISE",
            "AFFILIATION_CHANGED",
            "SUPERSEDED",
            "CESSATION_OF_OPERATION",
            "CERTIFICATE_HOLD",
            "PRIVILEGE_WITHDRAWN",
            "ATTRIBUTE_AUTHORITY_COMPROMISE"
          ]
        }
      }
    },
    "Subject": {
      "properties": {
        "rdnSequence": {
          "items": {
            "$ref": "RelativeDistinguishedName"
          }
        }
      }
    },
    "SubjectConfig": {
      "properties": {
        "subject": {
          "$ref": "Subject"
        }
      }
    },
    "SubjectDescription": {
      "properties": {
        "subject": {
          "$ref": "Subject"
        }
      }
    }
  }
}
