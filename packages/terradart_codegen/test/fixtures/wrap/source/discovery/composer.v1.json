          "$ref": "NetworkingConfig"
        },
        "networkingType": {
          "enum": [
            "NETWORKING_TYPE_UNSPECIFIED",
            "PRIVATE",
            "PUBLIC"
          ]
        }
      }
    },
    "SoftwareConfig": {
      "properties": {
        "auditLogsReplicationMode": {
          "enum": [
            "AUDIT_LOGS_REPLICATION_MODE_UNSPECIFIED",
            "AUDIT_LOGS_REPLICATION_DISABLED",
            "AUDIT_LOGS_REPLICATION_ENABLED"
