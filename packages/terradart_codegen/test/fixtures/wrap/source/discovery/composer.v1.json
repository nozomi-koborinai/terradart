{
  "name": "composer",
  "version": "v1",
  "revision": "20261015",
  "sourceUrl": "https://composer.googleapis.com/$discovery/rest?version=v1",
  "schemas": {
    "AirflowMetadataRetentionPolicyConfig": {
      "properties": {
        "retentionMode": {
          "enum": [
            "RETENTION_MODE_UNSPECIFIED",
            "RETENTION_MODE_ENABLED",
            "RETENTION_MODE_DISABLED"
          ]
        }
      }
    },
    "DataRetentionConfig": {
      "properties": {
        "taskLogsRetentionConfig": {
          "$ref": "TaskLogsRetentionConfig"
        },
        "airflowMetadataRetentionConfig": {
          "$ref": "AirflowMetadataRetentionPolicyConfig"
        }
      }
    },
    "Environment": {
      "properties": {
        "state": {
          "enum": [
            "STATE_UNSPECIFIED",
            "CREATING",
            "RUNNING",
            "UPDATING",
            "HIBERNATED",
            "DELETING",
            "ERROR"
          ]
        },
        "mode": {
          "enum": [
            "MODE_UNSPECIFIED",
            "DEVELOPMENT"
          ]
        },
        "config": {
          "$ref": "EnvironmentConfig"
        }
      }
    },
    "EnvironmentConfig": {
      "properties": {
        "softwareConfig": {
          "$ref": "SoftwareConfig"
        },
        "resilienceMode": {
          "enum": [
            "RESILIENCE_MODE_UNSPECIFIED",
            "HIGH_RESILIENCE"
          ]
        },
        "privateEnvironmentConfig": {
          "$ref": "PrivateEnvironmentConfig"
        },
        "dataRetentionConfig": {
          "$ref": "DataRetentionConfig"
        },
        "environmentSize": {
          "enum": [
            "ENVIRONMENT_SIZE_UNSPECIFIED",
            "ENVIRONMENT_SIZE_SMALL",
            "ENVIRONMENT_SIZE_MEDIUM",
            "ENVIRONMENT_SIZE_LARGE",
            "ENVIRONMENT_SIZE_EXTRA_LARGE"
          ]
        }
      }
    },
    "NetworkingConfig": {
      "properties": {
        "connectionType": {
          "enum": [
            "CONNECTION_TYPE_UNSPECIFIED",
            "VPC_PEERING",
            "PRIVATE_SERVICE_CONNECT"
          ]
