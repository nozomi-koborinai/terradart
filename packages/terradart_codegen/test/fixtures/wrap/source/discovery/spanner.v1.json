            "USE_DATABASE_ENCRYPTION",
            "GOOGLE_DEFAULT_ENCRYPTION",
            "CUSTOMER_MANAGED_ENCRYPTION"
          ]
        }
      }
    },
    "Database": {
      "properties": {
        "state": {
          "enum": [
            "STATE_UNSPECIFIED",
            "CREATING",
            "READY",
            "READY_OPTIMIZING"
          ]
        },
        "databaseDialect": {
          "enum": [
            "DATABASE_DIALECT_UNSPECIFIED",
            "GOOGLE_STANDARD_SQL",
            "POSTGRESQL"
          ]
        },
        "quorumInfo": {
          "$ref": "QuorumInfo"
        },
        "encryptionInfo": {
