{
  "name": "cloudidentity",
  "version": "v1",
  "revision": "20261026",
  "sourceUrl": "https://cloudidentity.googleapis.com/$discovery/rest?version=v1",
  "schemas": {
    "DynamicGroupMetadata": {
      "properties": {
        "status": {
          "$ref": "DynamicGroupStatus"
        },
        "queries": {
          "items": {
            "$ref": "DynamicGroupQuery"
          }
        }
      }
    },
    "DynamicGroupQuery": {
      "properties": {
        "resourceType": {
          "enum": [
            "RESOURCE_TYPE_UNSPECIFIED",
            "USER"
          ]
        }
      }
    },
    "DynamicGroupStatus": {
      "properties": {
        "status": {
          "enum": [
            "STATUS_UNSPECIFIED",
            "UP_TO_DATE",
            "UPDATING_MEMBERSHIPS",
            "INVALID_QUERY"
          ]
        }
      }
    },
    "Group": {
      "properties": {
        "dynamicGroupMetadata": {
          "$ref": "DynamicGroupMetadata"
        }
      }
    },
    "Membership": {
      "properties": {
        "type": {
          "enum": [
            "TYPE_UNSPECIFIED",
            "USER",
            "SERVICE_ACCOUNT",
            "GROUP",
            "SHARED_DRIVE",
            "CBCM_BROWSER",
            "CHROME_OS_DEVICE",
            "PERSONAL_AGENT",
            "COWORKER_AGENT",
            "OTHER"
          ]
