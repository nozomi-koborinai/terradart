{
  "name": "workstations",
  "version": "v1",
  "revision": "20261014",
  "sourceUrl": "https://workstations.googleapis.com/$discovery/rest?version=v1",
  "schemas": {
    "GceHyperdiskBalancedHighAvailability": {
      "properties": {
        "reclaimPolicy": {
          "enum": [
            "RECLAIM_POLICY_UNSPECIFIED",
            "DELETE",
            "RETAIN"
          ]
        }
      }
    },
    "GceRegionalPersistentDisk": {
      "properties": {
        "reclaimPolicy": {
          "enum": [
            "RECLAIM_POLICY_UNSPECIFIED",
            "DELETE",
            "RETAIN"
          ]
        }
      }
    },
    "PersistentDirectory": {
      "properties": {
        "gceHd": {
          "$ref": "GceHyperdiskBalancedHighAvailability"
        },
        "gcePd": {
          "$ref": "GceRegionalPersistentDisk"
        }
      }
    },
    "Workstation": {
      "properties": {
        "state": {
          "enum": [
            "STATE_UNSPECIFIED",
            "STATE_STARTING",
            "STATE_RUNNING",
            "STATE_STOPPING",
            "STATE_STOPPED",
            "STATE_SUSPENDING",
            "STATE_SUSPENDED"
          ]
        }
      }
    },
    "WorkstationCluster": {
      "properties": {}
    },
    "WorkstationConfig": {
      "properties": {
        "persistentDirectories": {
          "items": {
            "$ref": "PersistentDirectory"
          }
        },
        "idleAction": {
          "enum": [
            "IDLE_ACTION_UNSPECIFIED",
            "STOP",
            "SUSPEND"
          ]
        }
      }
    }
  }
}
