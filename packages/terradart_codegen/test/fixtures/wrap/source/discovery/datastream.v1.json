          "$ref": "GcsDestinationConfig"
        }
      }
    },
    "GcsDestinationConfig": {
      "properties": {
        "jsonFileFormat": {
          "$ref": "JsonFileFormat"
        }
      }
    },
    "IngestionTimePartition": {
      "properties": {
        "partitioningTimeGranularity": {
          "enum": [
            "PARTITIONING_TIME_GRANULARITY_UNSPECIFIED",
            "PARTITIONING_TIME_GRANULARITY_HOUR",
