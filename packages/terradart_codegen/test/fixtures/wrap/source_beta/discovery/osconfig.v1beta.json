{
  "name": "osconfig",
  "version": "v1beta",
  "revision": "20261106",
  "sourceUrl": "https://osconfig.googleapis.com/$discovery/rest?version=v1beta",
  "schemas": {
    "AptRepository": {
      "properties": {
        "archiveType": {
          "enum": [
            "ARCHIVE_TYPE_UNSPECIFIED",
            "DEB",
            "DEB_SRC"
          ]
        }
      }
    },
    "GuestPolicy": {
      "properties": {
        "recipes": {
          "items": {
            "$ref": "SoftwareRecipe"
          }
        },
        "packages": {
          "items": {
            "$ref": "Package"
          }
        },
        "packageRepositories": {
          "items": {
            "$ref": "PackageRepository"
          }
        }
      }
    },
    "Package": {
      "properties": {
        "desiredState": {
          "enum": [
            "DESIRED_STATE_UNSPECIFIED",
            "INSTALLED",
            "UPDATED",
            "REMOVED"
          ]
        },
        "manager": {
          "enum": [
            "MANAGER_UNSPECIFIED",
            "ANY",
            "APT",
            "YUM",
            "ZYPPER",
            "GOO"
          ]
        }
      }
    },
    "PackageRepository": {
      "properties": {
        "apt": {
          "$ref": "AptRepository"
        }
      }
    },
    "SoftwareRecipe": {
      "properties": {
        "desiredState": {
          "enum": [
            "DESIRED_STATE_UNSPECIFIED",
            "INSTALLED",
            "UPDATED",
            "REMOVED"
          ]
        },
        "installSteps": {
          "items": {
            "$ref": "SoftwareRecipeStep"
          }
        },
        "updateSteps": {
          "items": {
            "$ref": "SoftwareRecipeStep"
          }
        }
      }
    },
    "SoftwareRecipeStep": {
      "properties": {
        "scriptRun": {
          "$ref": "SoftwareRecipeStepRunScript"
        },
        "archiveExtraction": {
          "$ref": "SoftwareRecipeStepExtractArchive"
        }
      }
    },
    "SoftwareRecipeStepExtractArchive": {
      "properties": {
        "type": {
          "enum": [
            "ARCHIVE_TYPE_UNSPECIFIED",
            "TAR",
            "TAR_GZIP",
            "TAR_BZIP",
            "TAR_LZMA",
            "TAR_XZ",
            "ZIP"
          ]
        }
      }
    },
    "SoftwareRecipeStepRunScript": {
      "properties": {
        "interpreter": {
          "enum": [
            "INTERPRETER_UNSPECIFIED",
            "SHELL",
            "POWERSHELL"
          ]
        }
      }
    }
  }
}
