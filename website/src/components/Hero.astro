---
import HeroMark from "./HeroMark.astro";
---

<section class="hero">
  <div class="container-edit hero-inner">
    <div class="hero-copy">
      <p class="phase-badge">Alpha</p>

      <h1 class="display-hero">
        <span class="display-hero-line">Type-safe IaC</span>
        <span class="display-hero-line display-hero-accent">for Dart.</span>
      </h1>

      <p class="body-lead hero-lead">
        <strong>Your infrastructure and your app, one typed Dart codebase.</strong>
        Write Google Cloud, AWS, Cloudflare and Appwrite resources as Dart,
        emit standard <code>*.tf.json</code> for the
        <code>terraform apply</code> you already run, and hand every value
        your app needs to it as typed Dart.
      </p>

      <div class="terra-stratum" aria-hidden="true"></div>

      <div class="hero-cta">
        <a href="/docs/getting-started/" class="btn-primary">Get started</a>
        <a
          href="https://github.com/nozomi-koborinai/terradart"
          class="btn-secondary"
        >
          GitHub
        </a>
        <a href="https://pub.dev/packages/terradart_core" class="btn-secondary">
          pub.dev
        </a>
      </div>
    </div>

    <div class="hero-visual">
      <HeroMark />
    </div>
  </div>
</section>
