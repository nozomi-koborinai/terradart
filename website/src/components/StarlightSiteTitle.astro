---
import Logo from "./Logo.astro";
---

<a href="/" class="site-title" aria-label="TerraDart home">
  <Logo size={24} />
  <span class="site-title-section">Docs</span>
</a>

<style>
  .site-title {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    white-space: nowrap;
  }
  .site-title-section {
    padding-left: 0.75rem;
    border-left: 1px solid var(--td-line-strong);
    color: var(--td-mute);
    font-size: 0.9375rem;
    font-weight: 500;
  }
</style>
