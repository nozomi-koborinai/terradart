---
/** TerraDart mark — branding/svg/mark-light.svg (do not alter geometry). */
---

<svg
  class="hero-mark"
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 256 256"
  width="256"
  height="256"
  role="img"
  aria-hidden="true"
>
  <polygon points="32,48 224,48 180,152 76,152" fill="#13B9FD"></polygon>
  <polygon points="76,152 180,152 128,232" fill="#0175C2"></polygon>
  <rect x="60" y="96" width="136" height="6" fill="#1E2A56" opacity="0.88"></rect>
</svg>

<style>
  .hero-mark {
    width: min(100%, 280px);
    height: auto;
    display: block;
  }
  @media (min-width: 1024px) {
    .hero-mark {
      width: min(100%, 340px);
    }
  }
</style>
