---
import CopyCommand from "./CopyCommand.astro";
---

<section class="cta">
  <div class="container cta-inner">
    <h2 class="cta-title">Start with one Stack.</h2>
    <p class="cta-lead">Install the command, add a provider package, and apply.</p>
    <CopyCommand command="dart pub global activate terradart_cli" />
    <div class="hero-actions">
      <a href="/docs/getting-started/" class="button button--primary">Get started</a>
      <a href="https://github.com/nozomi-koborinai/terradart/tree/main/examples" class="button button--ghost">
        Browse examples
      </a>
    </div>
  </div>
</section>
