---
import ProviderIcon from "./ProviderIcon.astro";
import { providers } from "./providers";
---

<section class="works-with" aria-labelledby="works-with-label">
  <div class="container works-with-inner">
    <p id="works-with-label" class="works-with-label">Works with</p>
    <ul class="works-with-logos">
      {
        providers.map((p) => (
          <li>
            <a href={p.href} class="works-with-logo">
              <ProviderIcon id={p.id} size={22} />
              {p.name}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
