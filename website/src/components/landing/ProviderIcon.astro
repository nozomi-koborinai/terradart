---
/**
 * The icon beside a provider's name: a generic glyph of TerraDart's own, never
 * a vendor mark. Google needs an approved permission request for its logos,
 * AWS allows fair use in plain text only, Cloudflare logos need written
 * permission, and Appwrite publishes no monochrome mark that could sit at the
 * same muted tone as the rest. Keep the glyphs generic: none may imitate a
 * vendor's logo (Cloudflare's is a cloud, so its glyph is a globe).
 */
interface Props {
  id: string;
  size?: number;
}
const { id, size = 16 } = Astro.props;
---

<svg class="provider-icon" viewBox="0 0 24 24" width={size} height={size} aria-hidden="true">
  {id === "google" && <path d="M7 18.5h10.25a4.25 4.25 0 0 0 .55-8.46A5.75 5.75 0 0 0 6.9 9.1 4.7 4.7 0 0 0 7 18.5Z" />}
  {
    id === "aws" && (
      <>
        <rect x="4" y="4.5" width="16" height="6.25" rx="1.5" />
        <rect x="4" y="13.25" width="16" height="6.25" rx="1.5" />
        <path d="M7.5 7.6h.01M7.5 16.35h.01" />
      </>
    )
  }
  {
    id === "cloudflare" && (
      <>
        <circle cx="12" cy="12" r="8" />
        <ellipse cx="12" cy="12" rx="3.4" ry="8" />
        <path d="M4 12h16" />
      </>
    )
  }
  {
    id === "appwrite" && (
      <>
        <path d="M12 4 20 8.25 12 12.5 4 8.25Z" />
        <path d="m4 12.1 8 4.25 8-4.25" />
        <path d="m4 15.75 8 4.25 8-4.25" />
      </>
    )
  }
</svg>

<style>
  .provider-icon {
    flex: none;
    display: block;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
