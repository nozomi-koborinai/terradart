---
interface MissionCard {
  title: string;
  body: string;
}

interface Props {
  eyebrow?: string;
  heading: string;
  cards: MissionCard[];
}

const { eyebrow = "Mission", heading, cards } = Astro.props;
---

<section class="section rule-top">
  <div class="container-edit section-inner">
    <p class="section-label">{eyebrow}</p>
    <h2 class="display-section">{heading}</h2>

    <div class="mission-grid">
      {
        cards.map((card) => (
          <article class="mission-card">
            <h3 class="mission-card-title" set:html={card.title} />
            <p set:html={card.body} />
          </article>
        ))
      }
    </div>
  </div>
</section>
