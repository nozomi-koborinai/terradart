---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/landing/Nav.astro";
import Footer from "../components/landing/Footer.astro";
---

<Layout title="Privacy — TerraDart" description="terradart.dev privacy policy — Cloudflare Web Analytics (cookieless).">
  <Nav />
  <main class="section">
    <div class="container prose">
      <p class="eyebrow">Privacy</p>
      <h1 class="section-title">Privacy</h1>
      <p class="section-lead">terradart.dev does not use first-party cookies for tracking.</p>

      <h2>Analytics</h2>
      <p>
        We use <a href="https://www.cloudflare.com/web-analytics/">Cloudflare Web Analytics</a>, a cookieless service
        for aggregated traffic only.
      </p>

      <h2>Infrastructure</h2>
      <p>
        Hosted on Cloudflare Pages. Strictly necessary cookies may be set at the CDN layer (e.g. <code>__cf_bm</code>).
      </p>

      <h2>Contact</h2>
      <p><a href="https://github.com/nozomi-koborinai/terradart/issues">GitHub Issues</a></p>
    </div>
  </main>
  <Footer />
</Layout>
